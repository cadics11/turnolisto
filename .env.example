# --- AI (optional). Leave everything empty to use the built-in rule-based parser. ---
# The patient intake chat and the clinic voice commands share the same provider.
# If LLM_PROVIDER is empty it is auto-detected from the credentials below.
LLM_PROVIDER=anthropic   # anthropic | openai | openrouter | ollama
LLM_API_KEY=             # anthropic / openai
LLM_MODEL=               # e.g. claude-haiku-5-5 or gpt-4o-mini

GOOGLE_AI_STUDIO_HOST=
GEMINI_API_KEY=


# OpenRouter (LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=        # e.g. openai/gpt-4o-mini (free models end with ":free")

# Ollama (LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=            # e.g. llama3.1

# --- SMS ---
SMS_MODE=simulated       # simulated | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=      # e.g. +17875550000

# --- Database (required on Vercel) ---
# Leave empty locally to use data/turnolisto.json. Create one with: turso db create turnolisto
# then: turso db show turnolisto --url ; turso db tokens create turnolisto
TURSO_DATABASE_URL=      # libsql://your-db.turso.io
TURSO_AUTH_TOKEN=
